<%- include('partials/header') %>
<section class="page-intro">
    <p class="eyebrow">MAKE A DIFFERENCE</p>
    <h1><%= title %></h1>
    <p class="lead">Browse projects that match your interests, schedule, and neighborhood.</p>
</section>
<% if (user && user.role === 'admin') { %>
    <div class="admin-actions">
        <a class="button" href="/new-project">Add Project</a>
    </div>
<% } %>
<section class="project-list" aria-label="Service projects">
    <% projects.forEach((project, index) => { %>
        <article class="project-row">
            <span class="card-number">0<%= index + 1 %></span>
            <div>
                <h2><a href="/project/<%= project.project_id %>"><%= project.title %></a></h2>
            </div>
            <p class="muted"><%= project.location %></p>
            <p class="date"><%= project.date %></p>
            <a class="text-link" href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
            <% if (user && user.role === 'admin') { %>
                <a class="text-link" href="/edit-project/<%= project.project_id %>">Edit</a>
            <% } %>
        </article>
    <% }) %>
</section>
<%- include('partials/footer') %>
