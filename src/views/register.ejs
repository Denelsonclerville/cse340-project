<%- include('partials/header') %>
<section class="page-intro">
    <p class="eyebrow">JOIN THE COMMUNITY</p>
    <h1><%= title %></h1>
    <p class="lead">Create an account to connect with service opportunities in your community.</p>
</section>
<section class="form-section" aria-labelledby="register-title">
    <h2 id="register-title">Your account details</h2>
    <% if (error) { %>
        <p class="empty-state" role="alert"><%= error %></p>
    <% } %>
    <form class="admin-form" action="/register" method="POST">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" value="<%= formData.name %>" maxlength="150" autocomplete="name" required>

        <label for="email">Email</label>
        <input id="email" name="email" type="email" value="<%= formData.email %>" maxlength="255" autocomplete="email" required>

        <label for="password">Password</label>
        <input id="password" name="password" type="password" minlength="8" maxlength="72" autocomplete="new-password" required>
        <p class="muted">Use a password between 8 and 72 bytes long.</p>

        <div class="form-actions">
            <button class="button" type="submit">Create account</button>
            <a class="text-link" href="/login">I already have an account</a>
        </div>
    </form>
</section>
<%- include('partials/footer') %>
