<%- include('partials/header') %>
<section class="login-layout" aria-labelledby="login-title">
    <div class="login-welcome">
        <p class="eyebrow">WELCOME BACK</p>
        <h1>Good things happen when we come together.</h1>
        <p>Sign in to find your next opportunity to make a difference in your community.</p>
        <div class="login-highlight">
            <span class="login-highlight-mark" aria-hidden="true">+</span>
            <p><strong>Your community is counting on you.</strong><br>Pick up where your good work left off.</p>
        </div>
    </div>
    <div class="login-card">
        <p class="eyebrow">SERVE TOGETHER</p>
        <h2 id="login-title">Sign in to your account</h2>
        <p class="login-subtitle">Enter your details below to continue.</p>
        <% if (error) { %>
            <p class="login-error" role="alert"><%= error %></p>
        <% } %>
        <form class="login-form" action="/login" method="POST">
            <label for="email">Email address</label>
            <input id="email" name="email" type="email" placeholder="you@example.com" autocomplete="username" required>
            <label for="password">Password</label>
            <input id="password" name="password" type="password" placeholder="Enter your password" autocomplete="current-password" required>
            <button class="button login-button" type="submit">Log in <span aria-hidden="true">→</span></button>
        </form>
        <p class="login-register">New to Serve Together? <a class="text-link" href="/register">Create an account</a></p>
    </div>
</section>
<%- include('partials/footer') %>