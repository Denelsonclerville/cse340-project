<%- include('partials/header') %>
<article class="page-intro">
    <p class="eyebrow">SERVICE PROJECT</p>
    <h1><%= project.title %></h1>
    <p class="lead"><%= project.description %></p>
</article>
<section class="list-card" aria-label="Project details">
    <p><strong>Date:</strong> <%= project.date %></p>
    <p><strong>Location:</strong> <%= project.location %></p>
    <p><strong>Organization:</strong> <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
    <div>
        <strong>Categories:</strong>
        <% if (categories.length) { %>
            <% categories.forEach((category) => { %>
                <a class="tag" href="/category/<%= category.category_id %>"><%= category.name %></a>
            <% }) %>
        <% } else { %>
            <span class="muted">No categories assigned.</span>
        <% } %>
    </div>
    <% if (user) { %>
        <% if (isVolunteering) { %>
            <p class="notice" role="status">You are volunteering for this project.</p>
            <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                <button type="submit">Remove me as a volunteer</button>
            </form>
        <% } else { %>
            <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                <button type="submit">Volunteer for this project</button>
            </form>
        <% } %>
    <% } %>
    <% if (user && user.role === 'admin') { %>
        <a class="text-link" href="/edit-project/<%= project.project_id %>">Edit project</a>
        <a class="text-link" href="/project/<%= project.project_id %>/categories">Update Categories / Assign Categories</a>
    <% } %>
</section>
<%- include('partials/footer') %>