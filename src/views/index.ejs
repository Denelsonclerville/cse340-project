<%- include('partials/header') %>
<section class="hero">
    <div class="hero-copy">
        <p class="eyebrow">LOCAL ACTION, REAL IMPACT</p>
        <h1>Find your place in the community.</h1>
        <p class="lead">Serve Together connects people with meaningful service projects and the organizations making change happen nearby.</p>
        <a class="button" href="/projects">Explore projects <span aria-hidden="true">&#8594;</span></a>
    </div>
    <div class="hero-stat" aria-label="Community impact statistic">
        <strong><%= projectCount %></strong>
        <span>active opportunities</span>
    </div>
</section>
<section class="section-heading">
    <div>
        <p class="eyebrow">START HERE</p>
        <h2>Opportunities near you</h2>
    </div>
    <a class="text-link" href="/projects">View all projects <span aria-hidden="true">&#8594;</span></a>
</section>
<section class="card-grid" aria-label="Featured service projects">
    <% featuredProjects.forEach((project, index) => { %>
        <article class="project-card accent-<%= index + 1 %>">
            <span class="card-number">0<%= index + 1 %></span>
            <p class="tag"><%= project.category %></p>
            <h3><%= project.name %></h3>
            <p class="muted"><%= project.location %> &middot; <%= project.organization_name %></p>
            <a class="text-link" href="/projects">Learn more <span aria-hidden="true">&#8594;</span></a>
        </article>
    <% }) %>
</section>
<%- include('partials/footer') %>
