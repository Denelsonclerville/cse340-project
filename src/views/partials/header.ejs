<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%- title %> | Serve Together</title>
    <link rel="stylesheet" href="/css/main.css">
    <script src="/js/navigation.js" defer></script>
</head>
<body>
    <header>
        <a class="brand" href="/" aria-label="Serve Together home"><img src="/images/cse340-service-network.png" alt=""></a>
        <button class="menu-toggle" type="button" aria-label="Toggle navigation" aria-controls="site-navigation" aria-expanded="false"><span class="menu-icon-open" aria-hidden="true">☰</span><span class="menu-icon-close" aria-hidden="true">✕</span></button>
        <div class="nav-overlay" aria-hidden="true"></div>
        <nav id="site-navigation" aria-label="Main navigation">
            <button class="menu-close" type="button" aria-label="Close navigation">✕</button>
            <ul>
                <li><a class="<%= title === 'Serve Together' ? 'active' : '' %>" href="/">Home</a></li>
                <li><a class="<%= title === 'Organizations' ? 'active' : '' %>" href="/organizations">Organizations</a></li>
                <li><a class="<%= title === 'Service Projects' ? 'active' : '' %>" href="/projects">Projects</a></li>
                <li><a class="<%= title === 'Project Categories' ? 'active' : '' %>" href="/categories">Categories</a></li>
            </ul>
        </nav>
    </header>
    <div class="app-shell">
        <aside class="workspace-sidebar" aria-label="Account navigation">
            <p class="sidebar-heading"><%= user ? 'Workspace' : 'Account' %></p>
            <ul class="sidebar-links">
                <% if (user) { %>
                    <li>
                        <a class="<%= title === 'Dashboard' ? 'active' : '' %>" href="/dashboard">
                            <span aria-hidden="true">▦</span>Dashboard
                        </a>
                    </li>
                    <% if (user.role === 'admin') { %>
                        <li>
                            <a class="<%= title === 'Users' ? 'active' : '' %>" href="/users">
                                <span aria-hidden="true">◉</span>Profile
                            </a>
                        </li>
                    <% } else { %>
                        <li>
                            <a href="/dashboard#profile">
                                <span aria-hidden="true">◉</span>Profile
                            </a>
                        </li>
                    <% } %>
                    <li class="sidebar-action">
                        <form action="/logout" method="POST">
                            <button type="submit"><span aria-hidden="true">↪</span>Log out</button>
                        </form>
                    </li>
                <% } else { %>
                    <li>
                        <a class="<%= title === 'Log In' ? 'active' : '' %>" href="/login">
                            <span aria-hidden="true">↪</span>Log in
                        </a>
                    </li>
                <% } %>
            </ul>
        </aside>
    <main>
        <% if (notice) { %>
            <p class="notice" role="status"><%= notice %></p>
        <% } %>